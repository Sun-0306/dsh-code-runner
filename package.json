{
  "name": "dsh-code-runner",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Run Python, R, Node.js and other scripts from a DSH sidebar panel, with streaming output. · 在 DSH 侧栏面板里直接运行 Python、R、Node.js 等脚本，并实时查看输出。",
  "icon": "icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sun-0306/dsh-code-runner.git"
  },
  "homepage": "https://github.com/Sun-0306/dsh-code-runner#readme",
  "bugs": {
    "url": "https://github.com/Sun-0306/dsh-code-runner/issues"
  },
  "author": "Sun <Sun-0306@users.noreply.github.com>",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin"
  ]
}
